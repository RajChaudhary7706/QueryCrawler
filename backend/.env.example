PORT=5000
ALLOWED_ORIGIN=http://localhost:5173
# Set to true only if outbound HTTPS must use your configured HTTP(S) proxy.
USE_HTTP_PROXY=false
JINA_API_KEY=your_jina_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_768_dimension_pinecone_index
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the default Gemini model available to your API key.
GEMINI_MODEL=gemini-3-flash-preview
